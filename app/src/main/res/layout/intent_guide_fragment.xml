<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/m3_pitch_black">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/automation_guide_title"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/m3_text_primary"
        android:layout_margin="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread" />

    <View
        android:id="@+id/banner_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/m3_surface_stroke"
        app:layout_constraintTop_toBottomOf="@id/banner"
        app:layout_constraintStart_toStartOf="@id/banner"
        app:layout_constraintEnd_toEndOf="@id/banner" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/open_label"
        android:textSize="20sp"
        android:textColor="@color/m3_text_primary"
        android:layout_margin="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/banner_divider" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/open_intent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/open_intent"
        android:textSize="16sp"
        android:textColor="@color/m3_accent_primary"
        app:layout_constraintBottom_toBottomOf="@+id/copyButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_label" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/copyButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:icon="@drawable/baseline_text_snippet_white_24dp"
        app:iconTint="@color/m3_pitch_black"
        app:iconPadding="0dp"
        app:iconGravity="textStart"
        app:cornerRadius="16dp"
        app:backgroundTint="@color/m3_accent_primary"
        android:layout_marginStart="10dp"
        app:layout_constraintTop_toBottomOf="@id/text_label"
        app:layout_constraintStart_toEndOf="@id/open_intent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text_label2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/close_label"
        android:textSize="20sp"
        android:textColor="@color/m3_text_primary"
        android:layout_margin="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/copyButton" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/open_intent2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/close_intent"
        android:textSize="16sp"
        android:textColor="@color/m3_accent_primary"
        app:layout_constraintBottom_toBottomOf="@+id/copyButton2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_label2" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/copyButton2"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:icon="@drawable/baseline_text_snippet_white_24dp"
        app:iconTint="@color/m3_pitch_black"
        app:iconPadding="0dp"
        app:iconGravity="textStart"
        app:cornerRadius="16dp"
        app:backgroundTint="@color/m3_accent_primary"
        android:layout_marginStart="10dp"
        app:layout_constraintTop_toBottomOf="@id/text_label2"
        app:layout_constraintStart_toEndOf="@id/open_intent2" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/guide_text"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginBottom="20dp"
        android:autoSizeTextType="uniform"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text='@string/intentGuideText'
        android:textColor="@color/m3_text_secondary"
        android:textSize="15sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/guideButton"
        app:layout_constraintTop_toBottomOf="@id/copyButton2"
        app:layout_constraintVertical_weight="0.2" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/guideButton"
        android:layout_width="match_parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="12dp"
        app:cornerRadius="28dp"
        android:layout_height="56dp"
        android:textColor="@color/m3_text_primary"
        android:textStyle="bold"
        app:strokeColor="@color/m3_surface_stroke"
        app:strokeWidth="1dp"
        app:backgroundTint="@color/m3_surface_card"
        android:text="@string/guide_button"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toTopOf="@id/next_button" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/next_button"
        android:layout_width="match_parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        app:cornerRadius="28dp"
        android:layout_height="60dp"
        android:textColor="@color/m3_pitch_black"
        android:textStyle="bold"
        app:backgroundTint="@color/m3_accent_primary"
        app:icon="@drawable/baseline_arrow_forward_white_24dp"
        app:iconTint="@color/m3_pitch_black"
        app:iconGravity="end"
        android:text="@string/next"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>