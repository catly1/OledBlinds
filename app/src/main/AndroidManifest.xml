<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Without this the foreground service notification is silently dropped on Android 13+, which
         leaves the service running with no way for the user to see or reach it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />


    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:allowBackup="true"
        android:fullBackupContent="true">
        <activity
            android:name="com.catly.letterboxer.MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name="com.catly.letterboxer.floating_window.FloatingWindowService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            >
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Just puts a black box on the screen"/>
            <intent-filter>
                <action android:name="letterboxer.start"/>
            </intent-filter>
        </service>

        <service
            android:name="com.catly.letterboxer.floating_window.OLEDBlindsTileService"
            android:label="@string/app_tile_name"
            android:icon="@drawable/ic_oledsaveronoff"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            >
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <service
            android:name="com.catly.letterboxer.floating_window.AppWatcherService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/app_watcher_config" />
        </service>

        <service
            android:name="com.catly.letterboxer.floating_window.StopService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            >
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Takes the black box off the screen"/>
            <intent-filter>
                <action android:name="letterboxer.stop"/>
            </intent-filter>
        </service>

        <receiver
            android:name="com.catly.letterboxer.AppActionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.catly.letterboxer.APP_ACTION"/>
            </intent-filter>
        </receiver>
        <activity
            android:name="com.catly.letterboxer.StartActivity"
            android:exported="true"
            android:theme="@style/TransparentNoUI"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:finishOnTaskLaunch="true">

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="letterboxer.com" android:path="/start" />
            </intent-filter>
        </activity>

    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <category android:name="android.intent.category.DEFAULT"/>
            <data android:scheme="mailto"/>
        </intent>
        <!-- Lets the app picker list every launchable app. This is the narrow alternative to
             QUERY_ALL_PACKAGES: it grants visibility of apps with a launcher entry and nothing else. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>
</manifest>